# A hardened systemd unit for privcord-server. Install:
#   sudo useradd --system --home /var/lib/privcord --shell /usr/sbin/nologin privcord
#   sudo install -m 0755 privcord-server /usr/local/bin/
#   sudo install -d -m 0750 -o root -g privcord /etc/privcord
#   sudo install -m 0640 -o root -g privcord privcord-server.toml /etc/privcord/   (set data_dir = "/var/lib/privcord")
#   sudo cp contrib/privcord-server.service /etc/systemd/system/ && sudo systemctl enable --now privcord-server
# Check how tight it is: systemd-analyze security privcord-server
[Unit]
Description=PrivCord relay, Nostr and TURN server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/privcord-server --config /etc/privcord/privcord-server.toml serve
User=privcord
Group=privcord
Restart=on-failure
RestartSec=3
# Where it may write: only its own data directory (created 0700, owned by the service user).
StateDirectory=privcord
StateDirectoryMode=0700
UMask=0077
# Nothing else on the machine is reachable or writable.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
# Only network sockets, and only the system calls an ordinary service needs.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# No privileges at all; to listen on a port below 1024 (443, 80) use CAP_NET_BIND_SERVICE instead of running as root:
CapabilityBoundingSet=
AmbientCapabilities=
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE
# Limits: many open connections are normal; runaway memory is not.
LimitNOFILE=65536
TasksMax=4096
MemoryMax=1G
# The terminal's output goes to the journal: nothing secret is printed (the setup code works once, for 15 minutes).

[Install]
WantedBy=multi-user.target
